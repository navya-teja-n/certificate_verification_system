# Wallet used to deploy/issue certificates (testnet only — never use a mainnet key here)
PRIVATE_KEY=your_testnet_wallet_private_key_without_0x_prefix

# Sepolia RPC (get a free one from Alchemy/Infura, or use a public endpoint)
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Optional: for `forge verify-contract` / `--verify` on deploy
ETHERSCAN_API_KEY=your_etherscan_api_key
