# Address of the deployed CertificateRegistry contract on Sepolia
VITE_CERTIFICATE_CONTRACT_ADDRESS=0xD1526DCDd23398FFEed6161306fd1C4415dED723

# Sepolia RPC used for read-only calls before a wallet is connected
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Pinata JWT for pinning certificate metadata JSON to IPFS (pinata.cloud, free tier)
VITE_PINATA_JWT=

# Gateway used to read metadata back from IPFS
VITE_IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs
